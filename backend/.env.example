# Database (use sqlite for local dev, postgresql for production)
DATABASE_URL=sqlite:///./ato_detection.db

# Auth - MUST be changed in production
SECRET_KEY=your-secret-key-at-least-32-characters-long

# App
APP_ENV=development
# APP_ENV=production  # Uncomment for production

# CORS - add your frontend URL
CORS_ORIGINS=["http://localhost:5173"]

# ML paths (relative to backend/ directory)
ML_MODEL_PATH=models/model.joblib
SCALER_PATH=models/scaler.joblib
METADATA_PATH=models/model_metadata.json

# Risk thresholds (0-100)
RISK_LOW_THRESHOLD=30
RISK_HIGH_THRESHOLD=70

# MFA & SMS Configuration
MFA_OTP_EXPIRE_MINUTES=5
MFA_MAX_ATTEMPTS=5
MFA_RESEND_COOLDOWN_SECONDS=30

# SMS Provider ("mock" | "twilio" | "fast2sms")
# "mock" operates offline without credentials and logs/stores mock OTPs safely
SMS_PROVIDER=mock
SMS_TIMEOUT_SECONDS=8.0

# Twilio SMS Gateway (Required when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Fast2SMS Gateway - Indian SMS Gateway (Required when SMS_PROVIDER=fast2sms)
FAST2SMS_API_KEY=
